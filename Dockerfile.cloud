FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PORT=7860
RUN pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1' 'pwdlib[argon2]>=0.2,<1' 'PyJWT>=2.9,<3' 'python-multipart>=0.0.9,<1' 'email-validator>=2,<3' 'pymupdf>=1.24,<2' 'langchain-text-splitters>=0.3,<2'
ENV RAG_BACKEND=lexical MAX_UPLOAD_BYTES=1048576 DATABASE_PATH=/tmp/bizmind/db.sqlite3 UPLOAD_PATH=/tmp/bizmind/uploads
COPY backend/app /srv/app
COPY --from=web /web/dist /srv/static
COPY deploy/cloud_app.py /srv/cloud_app.py
RUN useradd -m -u 1000 demo && chown -R demo:demo /srv
USER demo
EXPOSE 7860
CMD ["sh", "-c", "uvicorn cloud_app:app --host 0.0.0.0 --port ${PORT:-7860}"]
